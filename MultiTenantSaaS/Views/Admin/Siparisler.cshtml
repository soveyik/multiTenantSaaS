@model IEnumerable<Siparis>
@{
    ViewData["Title"] = "Firma Siparişleri";
}

<h2>Tüm Siparişler (Admin Paneli)</h2>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">Hiç sipariş bulunamadı.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Sipariş GUID</th>
                <th>Kullanıcı Adı</th>
                <th>Tarih</th>
                <th>Tutar</th>
                <th>Detay</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var siparis in Model)
            {
                <tr>
                    <td><small>@siparis.Id</small></td>
                    <td>@siparis.Kullanici?.KullaniciAdi</td>
                    <td>@siparis.SiparisTarihi.ToString("g")</td>
                    <td>@siparis.ToplamTutar.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#order-@siparis.Id">
                            Ürünleri Gör
                        </button>
                    </td>
                </tr>
                <tr class="collapse" id="order-@siparis.Id">
                    <td colspan="5">
                        <div class="mb-3 p-3 bg-light rounded">
                            <strong>Sipariş Veren:</strong> @siparis.Kullanici?.KullaniciAdi <br/>
                            <strong>Sipariş Tarihi:</strong> @siparis.SiparisTarihi.ToString("g") <br/>
                            <strong>İletişim:</strong> @siparis.Telefon <br/>
                            <strong>Teslimat Adresi:</strong> @siparis.Adres
                        </div>
                        <ul class="list-group">
                            @foreach (var item in siparis.SiparisDetaylari)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @item.Urun?.Ad
                                    <span class="badge bg-primary rounded-pill">@item.Adet adet x @item.BirimFiyat.ToString("C")</span>
                                </li>
                            }
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

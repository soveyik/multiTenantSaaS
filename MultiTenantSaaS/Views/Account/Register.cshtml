@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h2 class="text-center mb-4">Kayıt Ol</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Register">
            <div class="mb-3">
                <label>Firma Kodu (Hangi firmaya kayıt olacaksınız?)</label>
                <input type="text" name="firmaKodu" class="form-control" required placeholder="örn: firma-a" />
            </div>
            <div class="mb-3">
                <label>Kullanıcı Adı</label>
                <input type="text" name="kullaniciAdi" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Şifre</label>
                <input type="password" name="sifre" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Kayıt Ol</button>
        </form>
        <div class="mt-3 text-center">
            <a asp-action="Login">Zaten hesabın var mı? Giriş Yap</a>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Giriş Yap";
}

<style>
    body {
        background-color: #f4f6f9;
    }
    .login-container {
        margin-top: 5rem;
    }
    .card-login {
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border: none;
    }
    .card-login .card-body {
        padding: 3rem;
    }
    .btn-login {
        padding: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        border-radius: 0.5rem;
    }
    .form-control {
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
    }
    .form-control:focus {
        background-color: #fff;
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
</style>

<div class="row justify-content-center login-container">
    <div class="col-md-5 col-lg-4">
        
        <div class="card card-login">
            <div class="card-body">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark">Hoş Geldiniz</h3>
                    <p class="text-muted small">Sisteme erişmek için giriş yapın.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger shadow-sm rounded-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }

                <form method="post" asp-action="Login">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Firma Kodu</label>
                        <input type="text" name="firmaKodu" class="form-control" required placeholder="Örn: firma-a" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Kullanıcı Adı</label>
                        <input type="text" name="kullaniciAdi" class="form-control" required placeholder="Kullanıcı adınız" />
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Şifre</label>
                        <input type="password" name="sifre" class="form-control" required placeholder="••••••••" />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 btn-login mb-3">Giriş Yap</button>
                </form>
                
                <div class="text-center">
                    <span class="text-muted">Hesabınız yok mu?</span>
                    <a asp-action="Register" class="text-decoration-none fw-bold ms-1">Kayıt Ol</a>
                </div>
            </div>
        </div>
        
    </div>
</div>
